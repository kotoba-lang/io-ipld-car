{:paths ["src"]
 ;; CAR is a byte container for blocks io-ipld already knows how to make:
 ;; multiformats supplies CIDv1 assembly + base32, io-ipld the DAG-CBOR header
 ;; and the tag-42 root links. This repo owns framing, offsets and the index.
 :deps {io.github.kotoba-lang/io-ipld {:git/sha "aa751442934128232065d25b74b200cffb13ac70"}
        io.github.kotoba-lang/io-multiformats {:git/sha "b3b157e683a943d4f2e9362d9366cceefff3f656"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
